{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["typescript", "unicorn", "oxc"],
  "env": {
    "node": true,
    "es2023": true
  },
  "rules": {
    "no-console": "error",
    "oxc/no-async-endpoint-handlers": "off"
  },
  "overrides": [
    {
      "files": ["src/index.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["packages/server/src/index.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}

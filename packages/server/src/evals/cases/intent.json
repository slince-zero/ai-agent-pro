      "contentType": ["教程", "文章"],
      "hardConstraints": {
        "has": [["初学", "入门", "新手"], "示例"],
        "lacks": ["TypeScript"]
      },
      "exclusions": { "has": ["框架"] },
      "preferences": { "has": ["TypeScript"] }
    }
  },
  {
    "id": "preference-not-promoted",

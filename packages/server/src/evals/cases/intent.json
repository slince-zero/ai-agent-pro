[
  {
    "id": "baseline-tutorial",
    "why": "产品计划里的标准例句：四类条件各有一条，任何一类分错都说明解析器的基本盘有问题",
    "tags": ["baseline"],
    "input": "帮我找适合初学者的 Agent context engineering 教程，需要有完整示例，最好是 TypeScript，排除只介绍框架用法的文章。",
    "expect": {

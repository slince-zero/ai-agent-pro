{
  "name": "ai-agent-pro",
  "version": "0.0.0",
  "private": true,
  "description": "A learning-first, context-centered retrieval agent built from first principles.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @ai-agent-pro/client --filter @ai-agent-pro/server dev",
    "build": "pnpm --filter './packages/*' build",
    "test": "pnpm --filter './packages/*' test",
    "typecheck": "pnpm --filter './packages/*' typecheck",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint:ci": "pnpm lint && pnpm fmt:check"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.2"
}

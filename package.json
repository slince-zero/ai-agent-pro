{
  "name": "ai-agent-pro",
  "version": "0.0.0",
  "private": true,
  "description": "A learning-first, context-centered retrieval agent built from first principles.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",

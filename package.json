    "fmt:check": "oxfmt --check",
    "lint:ci": "pnpm lint && pnpm fmt:check"
  },
  "dependencies": {
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.2"
}

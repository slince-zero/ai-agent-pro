{
  "fixture": "fixtures/tiny-service",
  "cases": [
    {
      "id": "project-purpose",
      "question": "这个项目是做什么的？",
      "expectedFacts": ["用于仓库理解评测的确定性 HTTP fixture"],
      "expectedSources": ["README.md#L1-L3"]
    },
    {
      "id": "application-entry",
      "question": "应用入口在哪里？",
      "expectedFacts": ["src/index.ts 启动 Node.js HTTP server"],
      "expectedSources": ["src/index.ts#L1-L12", "package.json#L5-L7"]
    },
    {
      "id": "request-flow",
      "question": "一次请求经过哪些主要模块？",
      "expectedFacts": ["index.ts 接收请求", "app.ts 路由请求", "users.ts 提供用户数据"],
      "expectedSources": ["src/index.ts#L8-L12", "src/app.ts#L8-L18", "src/users.ts#L1-L8"]
    },
    {
      "id": "health-route",
      "question": "健康检查接口返回什么？",
      "expectedFacts": ["GET /health 返回状态 200 和 { ok: true }"],
      "expectedSources": ["src/app.ts#L9-L11"]
    },
    {
      "id": "users-route",
      "question": "用户列表从哪里获取？",
      "expectedFacts": ["/users 调用 listUsers", "用户数据定义在 src/users.ts"],
      "expectedSources": ["src/app.ts#L13-L15", "src/users.ts#L1-L8"]
    },
    {
      "id": "port-config",
      "question": "服务端口如何配置？",
      "expectedFacts": ["读取 PORT 环境变量", "默认端口为 3000"],
      "expectedSources": ["src/config.ts#L1-L5", "src/index.ts#L6-L12"]
    },
    {
      "id": "not-found",
      "question": "未知路径如何处理？",
      "expectedFacts": ["返回 404", "响应体包含 Not found"],
      "expectedSources": ["src/app.ts#L17-L18"]
    },
    {
      "id": "unsupported-database",
      "question": "这个项目使用什么数据库？",
      "expectedFacts": ["项目没有数据库"],
      "expectedSources": ["README.md#L11-L11"]
    }
  ]
}
